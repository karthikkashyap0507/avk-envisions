# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# database (SQLite)
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm
/prisma/dev.db*

# local uploads (development storage driver)
/public/uploads
/storage

# vercel
.vercel

# typescript
*.tsbuildinfo

# editors
.idea
.vscode/*
!.vscode/extensions.json

# Local runtime logs
*.log

# Locally installed analysis PDFs (production keeps these in /var/lib/avkvisions)
/public/pdf.worker.min.mjs
/synopses/

# Local Drive mirror used to build the synopsis manifest (~270 MB)
/.drive/

# PDF.js worker, copied from node_modules by scripts/copy-pdf-worker.mjs

# Question-paper scans fetched at import time (production caches these in /var/lib/avkvisions)
/question-papers/

# 2011 source documents fetched at import time
/kas-2011/

# Source documents dropped in the project root for import. The copies the app
# actually serves live under prisma/assets, so committing both would carry the
# same megabytes twice.
/*.pdf

# OCR intermediates. The parsed result is committed as prisma/data/*.json.
ocr-*.txt

# Python caches (translator/)
__pycache__/
*.pyc
