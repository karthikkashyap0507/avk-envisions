{
  "name": "avk-visions",
  "version": "0.1.0",
  "private": true,
  "description": "AVK Envisions — premium online test series and exam preparation platform.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/copy-pdf-worker.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:kas": "tsx prisma/seed-kas-polity.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "worker": "tsx src/server/jobs/worker.ts",
    "db:seed:catalogue": "tsx prisma/seed-catalogue.ts",
    "db:seed:2011": "tsx prisma/seed-kas-2011.ts",
    "db:prune:kas": "tsx prisma/prune-to-kas.ts",
    "db:synopses": "tsx prisma/install-synopses.ts",
    "db:free": "tsx prisma/make-everything-free.ts",
    "db:import:pyq": "tsx prisma/import-pyq-questions.ts",
    "db:import:papers": "tsx prisma/import-question-papers.ts",
    "db:import:2011": "tsx prisma/import-2011.ts",
    "db:figures": "tsx prisma/backfill-figures.ts",
    "db:hide-empty": "tsx prisma/hide-empty-tests.ts",
    "db:pyq-durations": "tsx prisma/set-pyq-subject-durations.ts",
    "db:offline": "tsx prisma/set-offline-enrolments.ts",
    "db:fix-modes": "tsx prisma/fix-test-modes.ts",
    "db:publish-questions": "tsx prisma/publish-attached-questions.ts",
    "db:free-tests": "tsx prisma/build-free-tests.ts",
    "db:reformat": "tsx prisma/reformat-questions.ts",
    "db:50days": "tsx prisma/seed-50-days.ts",
    "db:free-test-1": "tsx prisma/import-free-test-1.ts",
    "db:orphans": "tsx prisma/find-orphan-questions.ts",
    "db:pricing": "tsx prisma/set-pricing.ts",
    "db:50days:schedule": "tsx prisma/import-50-days-schedule.ts",
    "db:paid:schedule": "tsx prisma/import-paid-schedule.ts",
    "db:2024aug": "tsx prisma/merge-2024-august-p1.ts",
    "db:2024aug:paste": "tsx prisma/add-2024-august-p1-pasted.ts",
    "db:pyq-bundle": "tsx prisma/create-pyq-bundle.ts",
    "db:2024aug:promote": "tsx prisma/promote-2024-august-p1-import.ts",
    "db:paid:prune": "tsx prisma/prune-paid-series.ts",
    "db:swap-years": "tsx prisma/swap-2015-2017.ts",
    "db:clear-2015": "tsx prisma/clear-2015-attempts.ts",
    "db:replace-free": "tsx prisma/replace-free-test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@hookform/resolvers": "^3.9.1",
    "@node-rs/argon2": "^2.0.2",
